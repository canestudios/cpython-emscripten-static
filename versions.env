# The pinned inputs of one release. Its tag is
#   cpython-<PYTHON_VERSION>_numpy-<NUMPY_VERSION>_emsdk-<EMSDK_VERSION>-r<REVISION>
# Raise REVISION for any recipe change that changes the archive while the versions stay the same, and reset it
# to 1 when a version changes. A tag is never reused.

# The Python of Unreal Engine 5.9 (Engine/Binaries/ThirdParty/Python3), whose bytecode UnrealPy's web build runs.
PYTHON_VERSION=3.11.8
PYTHON_SHA256=d3019a613b9e8761d260d9ebe3bd4df63976de30464e5c0189566e1ae3f61889

# The NumPy UnrealPy's desktop headers pin (its plugin's Source/ThirdParty/NumPy/provenance.json).
NUMPY_VERSION=2.4.6
NUMPY_URL=https://files.pythonhosted.org/packages/d0/ad/fed0499ce6a338d2a03ebae59cd15093910c8875328855781952abf6c2fe/numpy-2.4.6.tar.gz
NUMPY_SHA256=f3a3570c4a2a16746ac2c31a7c7c7b0c186b95ce902e33db6f28094ed7387dda

# The Emscripten Unreal Engine's Wasm platform requires (Engine/Platforms/Wasm/Config/Wasm_SDK.json), and the emsdk
# commit of its tag: the commit fixes which compiler binaries that version name downloads.
EMSDK_VERSION=6.0.10
EMSDK_COMMIT=a2b92777574c2feda07994cd4f1079a3dfc151f8

REVISION=1
